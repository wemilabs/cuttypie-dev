# Resend
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# Email
DEFAULT_SENDER_EMAIL_ADDRESS=default_sender@yourdomain.com
DEFAULT_RECEPIENT_EMAIL_ADDRESS=default_receiver@yourdomain.com

# Database
DATABASE_URL=connection_string

# Better Auth (generate secret with: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers
GITHUB_CLIENT_ID=github_oauth_client_id
GITHUB_CLIENT_SECRET=github_oauth_client_secret
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_CLIENT_SECRET=google_oauth_client_secret
